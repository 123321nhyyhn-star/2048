{
  "name": "core-2048",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs && node scripts/sync-harmony.mjs",
    "preview": "node scripts/serve.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "qa": "node scripts/qa-server.mjs",
    "harmony:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-hap.ps1",
    "harmony:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-hap.ps1 -Product release -BuildMode release -App",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  }
}
